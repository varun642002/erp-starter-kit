# Copy this file to `.env` and fill in your own values. Never commit `.env`.

# ---- PostgreSQL (required) -------------------------------------------------
SQL_HOST=127.0.0.1
SQL_USER=postgres
SQL_PASSWORD=change-me
SQL_DB_NAME=erp
# Only for `npm run db:push` (creates the tables). Use a user that may create tables.
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=change-me

# ---- App ----------------------------------------------------------------------
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000     # used in bill and payment links
# AUTH_MODE=enforce                        # default in production: reject unverified API calls
# DEV_AUTH_BYPASS=1                        # local development only, refused in production
# SEED_SAMPLE_DATA=1                       # fill an EMPTY database with the fictional sample data once

# ---- WhatsApp Business Cloud API (optional) ---------------------------------
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_THANKYOU_TEMPLATE_NAME=
# WHATSAPP_REMINDER_TEMPLATE_NAME=
# WHATSAPP_MARKETING_TEMPLATE_NAME=
# WHATSAPP_BROADCAST_TEMPLATE_NAME=
# WHATSAPP_DAILY_TEMPLATE_NAME=daily_report
# WHATSAPP_DAILY_TEMPLATE_LANG=en
# REMINDER_COOLDOWN_DAYS=
# THANKYOU_START_DATE=
# DAILY_REPORT_KEY=                        # secret sent by your scheduler to /internal/daily-report

# ---- AI assistant (optional, the assistant also works without it) -----------
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=
# VOICE_MODEL=
# ASSISTANT_SIGNING_KEY=
